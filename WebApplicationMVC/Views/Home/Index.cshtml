@model IEnumerable<WebApplicationMVC.Models.Book>

@{
    ViewBag.Title = "Список книг";
}

<h2>Список книг</h2>

<p>
    @Html.ActionLink("Добавить книгу", "Create", null, new { @class = "btn btn-primary" })
</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>ID</th>
            <th>Название</th>
            <th>Автор</th>
            <th>Год</th>
            <th>ISBN</th>
            <th>Действия</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var book in Model)
        {
            <tr>
                <td>@book.Id</td>
                <td>@book.Title</td>
                <td>@book.Author</td>
                <td>@book.YearPublished</td>
                <td>@book.ISBN</td>
                <td>
                    @Html.ActionLink("Просмотр", "Details", new { id = book.Id }, new { @class = "btn btn-info btn-sm" })
                    @Html.ActionLink("Изменить", "Edit", new { id = book.Id }, new { @class = "btn btn-warning btn-sm" })
                    @Html.ActionLink("Удалить", "Delete", new { id = book.Id }, new { @class = "btn btn-danger btn-sm" })
                </td>
            </tr>
        }
    </tbody>
</table>