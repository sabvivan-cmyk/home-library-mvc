@model WebApplicationMVC.Models.Book

@{
    ViewData["Title"] = Model.Title;
}

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-start mb-4">
        <div>
            <h1 class="h2 mb-1">
                @Model.Title
            </h1>

            <div class="text-muted">
                @Model.Author
            </div>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="XmlData"
               asp-route-id="@Model.Id"
               class="btn btn-outline-primary">
                XML данные
            </a>
            <a asp-action="Edit"
               asp-route-id="@Model.Id"
               class="btn btn-primary">
                Редактировать
            </a>
            <a asp-action="Index"
               class="btn btn-outline-secondary">
                Назад
            </a>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-4">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <h2 class="h5 mb-3">
                        Информация
                    </h2>
                    <div class="mb-3">
                        <div class="text-muted small">
                            Автор
                        </div>
                        <div>@Model.Author</div>
                    </div>
                    <div class="mb-3">
                        <div class="text-muted small">
                            Год издания
                        </div>
                        <div>
                            @(Model.YearPublished?.ToString() ?? "—")
                        </div>
                    </div>
                    <div>
                        <div class="text-muted small">
                            ISBN
                        </div>
                        <div>
                            @(Model.ISBN ?? "—")
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-8">

            @if (!string.IsNullOrWhiteSpace(Model.Description))
            {
                <div class="card shadow-sm border-0 mb-4">
                    <div class="card-body">
                        <h2 class="h5">
                            Описание
                        </h2>
                        <p class="mb-0">
                            @Model.Description
                        </p>
                    </div>
                </div>
            }

            <div class="card shadow-sm border-0">
                <div class="card-body p-4">
                    <h2 class="h5 mb-4">
                        Оглавление
                    </h2>

                    @if (!string.IsNullOrWhiteSpace(Model.TableOfContentsHtml))
                    {
                        <div class="book-content">
                            @Html.Raw(Model.TableOfContentsHtml)
                        </div>
                    }
                    else
                    {
                        <p class="text-muted mb-0">
                            Оглавление не заполнено
                        </p>
                    }

                </div>
            </div>
        </div>
    </div>
</div>